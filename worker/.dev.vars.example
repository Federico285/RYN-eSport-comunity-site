# Secret Discord Incoming Webhook. Configurare localmente in .dev.vars e in produzione con Wrangler secret.
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...

# Secret key Cloudflare Turnstile. Usare chiavi di test solo in sviluppo.
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Origin separati da virgola. Non usare * per /apply.
ALLOWED_ORIGINS=http://localhost:5173,https://example.com
