# URL pubblico del Cloudflare Worker. In sviluppo puoi usare /apply tramite proxy Vite.
VITE_APPLICATION_API_URL=

# Site key pubblica Cloudflare Turnstile. Le chiavi di test Cloudflare vanno bene in sviluppo.
VITE_TURNSTILE_SITE_KEY=

# Invite Discord generato con lo script in /scripts.
VITE_DISCORD_INVITE_URL=https://discord.gg/placeholder
